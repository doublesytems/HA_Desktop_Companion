<Window x:Class="HADC_REBORN.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="620"
        Width="860"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="status" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Save" Width="90" Height="27" Click="save_Click" IsDefault="True"/>
                <Button Content="Close" Width="90" Height="27" Margin="8,0,0,0" Click="close_Click"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="tabs" SelectionChanged="tabs_SelectionChanged">
            <TabItem Header="Connection">
                <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Home Assistant URL"/>
                    <TextBox x:Name="url" Margin="0,2,0,10" Height="24" VerticalContentAlignment="Center"/>
                    <TextBlock Text="API Token"/>
                    <PasswordBox x:Name="token" Margin="0,2,0,10" Height="24" VerticalContentAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Text="Changing the URL or token registers this computer with Home Assistant again when you save."/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock x:Name="api_status" Text="Api" FontWeight="Bold" Foreground="Red" Margin="0,0,16,0"/>
                        <TextBlock x:Name="ws_status" Text="WebSocket" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="12" MaxWidth="520" HorizontalAlignment="Left">
                    <CheckBox x:Name="autostart" Content="Start with Windows" Margin="0,0,0,10"/>
                    <CheckBox x:Name="debug" Content="Detailed logging" Margin="0,0,0,10"/>
                    <CheckBox x:Name="keys" Content="Allow Home Assistant to send key presses to this computer" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,6" Text="Everything in this window except the connection is stored in configuration.yaml. Saving here rewrites that file, comments in it are not kept. The previous version is kept as configuration.yaml.bak."/>
                    <Button Content="Open configuration.yaml" Width="180" Height="27" HorizontalAlignment="Left" Click="openYaml_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Sensors">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,6,0,0">
                            <Button Content="Add" Height="27" Margin="0,0,2,0" Click="addSensor_Click"/>
                            <Button x:Name="duplicateSensor" Content="Duplicate" Height="27" Margin="2,0,2,0" Click="duplicateSensor_Click"/>
                            <Button x:Name="removeSensor" Content="Remove" Height="27" Margin="2,0,0,0" Click="removeSensor_Click"/>
                        </UniformGrid>
                        <ListBox x:Name="sensorList" DisplayMemberPath="Title" SelectionChanged="sensorList_SelectionChanged"/>
                    </DockPanel>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="sensorForm" Margin="4,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Microphone">
                <StackPanel Margin="12" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Microphone"/>
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" x:Name="microphone" DisplayMemberPath="Name" SelectedValuePath="Id" Height="24" SelectionChanged="microphone_SelectionChanged"/>
                        <Button Grid.Column="1" Content="Refresh" Width="80" Height="24" Margin="6,0,0,0" Click="refreshMicrophones_Click"/>
                    </Grid>
                    <TextBlock x:Name="microphoneStatus" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <GroupBox Header="Sensors for this microphone" Padding="8">
                        <StackPanel>
                            <CheckBox x:Name="micInUse" Content="In use (an app is recording from it)" Margin="0,0,0,8" Click="microphoneSensor_Click"/>
                            <CheckBox x:Name="micMuted" Content="Muted" Margin="0,0,0,8" Click="microphoneSensor_Click"/>
                            <CheckBox x:Name="micVolume" Content="Volume" Click="microphoneSensor_Click"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,0" Text="These sensors follow the microphone picked above. The existing 'Microphone in use' sensor is something else: it reports any app using any microphone."/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
